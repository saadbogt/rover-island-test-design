{% comment %} <span class="field-currency">{{ cart.currency.symbol }}</span>

<div class="field">
  <input
    class="field__input"
    name="{{ filter.min_value.param_name }}"
    id="{{ id_prefix }}{{ filter.label | escape }}-GTE"
    {%- if filter.min_value.value -%}
      value="{{ filter.min_value.value | money_without_currency }}"
    {%- endif -%}
    type="text"
    inputmode="decimal"
    placeholder="0"
    data-pattern="\d| |,|\."
    data-min="0"
    data-max="{{ filter.range_max | money_without_currency }}"
  >
  <label class="field__label" for="{{ id_prefix }}{{ filter.label | escape }}-GTE">
    {{- 'products.facets.from' | t -}}
  </label>
</div>

{%- if filter_type != 'vertical' -%}
  <span class="field-currency">{{ cart.currency.symbol }}</span>
{%- endif -%}

<div class="field">
  <input
    class="field__input"
    name="{{ filter.max_value.param_name }}"
    id="{{ id_prefix }}{{ filter.label | escape }}-LTE"
    {%- if filter.max_value.value -%}
      value="{{ filter.max_value.value | money_without_currency }}"
    {%- endif -%}
    type="text"
    inputmode="decimal"
    placeholder="{{ filter.range_max | money_without_currency }}"
    data-pattern="\d| |,|\."
    data-min="0"
    data-max="{{ filter.range_max | money_without_currency }}"
  >
  <label class="field__label" for="{{ id_prefix }}{{ filter.label | escape }}-LTE">
    {{- 'products.facets.to' | t -}}
  </label>
</div> {% endcomment %}
{%- liquid
  assign range_max = filter.range_max | money_without_currency | remove: ',' | strip | plus: 0
  assign min_value = filter.min_value.value | default: 0
  assign max_value = filter.max_value.value | default: range_max
-%}

<div class="custom-price-range" data-price-range>

  <div class="custom-price-range__values">
    <span class="custom-price-range__value" data-price-min-display>
      {{ min_value | money }}
    </span>

    <span class="custom-price-range__separator">–</span>

    <span class="custom-price-range__value" data-price-max-display>
      {{ max_value | money }}
    </span>
  </div>

  <div
    class="custom-price-range__slider"
    data-min="0"
    data-max="{{ range_max }}"
  >

    {%- comment -%}
      Track and progress bars must never be truly empty elements — some
      theme resets (and Dawn's own base.css in certain versions) apply
      `:empty { display: none }` to any div with zero child nodes/text,
      which collapses these to nothing. A non-breaking space forces the
      element to have text content so it always renders regardless of
      any global empty-element reset.
    {%- endcomment -%}
    <div class="custom-price-range__track">&nbsp;</div>
    <div class="custom-price-range__progress" data-price-progress>&nbsp;</div>

    <input
      type="range"
      class="custom-price-range__input custom-price-range__input--min"
      min="0"
      max="{{ range_max }}"
      value="{{ min_value }}"
      step="1"
      aria-label="Minimum price"
      data-price-min-slider
    >

    <input
      type="range"
      class="custom-price-range__input custom-price-range__input--max"
      min="0"
      max="{{ range_max }}"
      value="{{ max_value }}"
      step="1"
      aria-label="Maximum price"
      data-price-max-slider
    >
  </div>

  {%- comment -%}
    Keep Shopify's original price filter inputs.
    They are visually hidden but remain functional so
    Shopify filtering/AJAX continues to work normally.
  {%- endcomment -%}

  <div class="custom-price-range__hidden-fields">

    <input
      class="field__input"
      name="{{ filter.min_value.param_name }}"
      id="{{ id_prefix }}{{ filter.label | escape }}-GTE"
      type="text"
      inputmode="decimal"
      value="{{ min_value }}"
      data-price-min-input
      aria-hidden="true"
      tabindex="-1"
    >

    <input
      class="field__input"
      name="{{ filter.max_value.param_name }}"
      id="{{ id_prefix }}{{ filter.label | escape }}-LTE"
      type="text"
      value="{{ max_value }}"
      data-price-max-input
      aria-hidden="true"
      tabindex="-1"
    >

  </div>

</div>

<style>
  .custom-price-range {
    width: 100%;
    padding: 8px 0 10px;
  }

  .custom-price-range__values {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
    font-size: 13px;
    line-height: 1.4;
  }

  .custom-price-range__value {
    font-weight: 500;
    white-space: nowrap;
  }

  .custom-price-range__separator {
    margin: 0 8px;
    opacity: 0.5;
  }

  .custom-price-range__slider {
    position: relative;
    height: 24px;
    width: 100%;
  }

  /* Explicit min-height + font-size:0/line-height:0 hides the &nbsp;
     glyph visually while guaranteeing the element is never :empty
     and never collapses under any global reset. */
  .custom-price-range__track,
  .custom-price-range__progress {
    display: block;
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    height: 3px;
    min-height: 3px;
    line-height: 0;
    font-size: 0;
    border-radius: 3px;
    pointer-events: none;
  }

  .custom-price-range__track {
    width: 100%;
    background: rgba(0, 0, 0, 0.15);
  }

  .custom-price-range__progress {
    width: 0%;
    background: currentColor;
  }

  .custom-price-range__input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 24px;
    margin: 0;
    padding: 0;
    background: transparent;
    appearance: none;
    -webkit-appearance: none;
    pointer-events: none;
    outline: none;
  }

  .custom-price-range__input::-webkit-slider-runnable-track {
    height: 3px;
    background: transparent;
  }

  .custom-price-range__input::-moz-range-track {
    height: 3px;
    background: transparent;
  }

  .custom-price-range__input::-webkit-slider-thumb {
    width: 18px;
    height: 18px;
    margin-top: -7.5px;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: rgb(var(--color-background));
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    pointer-events: auto;
  }

  .custom-price-range__input::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: rgb(var(--color-background));
    cursor: pointer;
    pointer-events: auto;
  }

  .custom-price-range__input--max {
    z-index: 2;
  }

  .custom-price-range__input--min {
    z-index: 3;
  }

  .custom-price-range__hidden-fields {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  @media screen and (max-width: 749px) {
    .custom-price-range {
      padding-top: 5px;
    }

    .custom-price-range__values {
      font-size: 14px;
      margin-bottom: 20px;
    }

    .custom-price-range__input::-webkit-slider-thumb {
      width: 20px;
      height: 20px;
      margin-top: -8.5px;
    }

    .custom-price-range__input::-moz-range-thumb {
      width: 20px;
      height: 20px;
    }
  }
</style>

<script>
  (() => {
    function initPriceRanges() {
      document.querySelectorAll('[data-price-range]').forEach((range) => {
        if (range.dataset.initialized === 'true') return;
        range.dataset.initialized = 'true';

        const minSlider = range.querySelector('[data-price-min-slider]');
        const maxSlider = range.querySelector('[data-price-max-slider]');

        const minInput = range.querySelector('[data-price-min-input]');
        const maxInput = range.querySelector('[data-price-max-input]');

        const minDisplay = range.querySelector('[data-price-min-display]');
        const maxDisplay = range.querySelector('[data-price-max-display]');

        const progress = range.querySelector('[data-price-progress]');

        if (!minSlider || !maxSlider || !minInput || !maxInput) return;

        const maxPrice = Number(maxSlider.max);
        const MIN_GAP = 1; // smallest allowed distance between handles, in price units

        function formatPrice(value) {
          return new Intl.NumberFormat('en-AE', {
            style: 'currency',
            currency: '{{ cart.currency.iso_code }}',
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }).format(Number(value));
        }

        function paint(min, max) {
          const minPercent = (min / maxPrice) * 100;
          const maxPercent = (max / maxPrice) * 100;

          progress.style.left = minPercent + '%';
          progress.style.width = Math.max(maxPercent - minPercent, 0) + '%';

          minDisplay.textContent = formatPrice(min);
          maxDisplay.textContent = formatPrice(max);

          minInput.value = min;
          maxInput.value = max;
        }

        /*
         * Each slider's own 'input' handler clamps ONLY the slider that
         * is actually firing the event (event.target), never the other
         * one. This avoids relying on document.activeElement, which is
         * unreliable mid-drag on range inputs in some browsers/touch
         * environments and was the cause of the handle jumping to the
         * opposite end.
         */
        function onMinInput(event) {
          let min = Number(event.target.value);
          let max = Number(maxSlider.value);

          if (min > max - MIN_GAP) {
            min = max - MIN_GAP;
            minSlider.value = min;
          }

          paint(min, max);
        }

        function onMaxInput(event) {
          let max = Number(event.target.value);
          let min = Number(minSlider.value);

          if (max < min + MIN_GAP) {
            max = min + MIN_GAP;
            maxSlider.value = max;
          }

          paint(min, max);
        }

        function applyFilter() {
          /*
           * Trigger Shopify Dawn's existing price-range
           * filtering mechanism.
           */
          minInput.dispatchEvent(new Event('change', { bubbles: true }));
          maxInput.dispatchEvent(new Event('change', { bubbles: true }));
        }

        minSlider.addEventListener('input', onMinInput);
        maxSlider.addEventListener('input', onMaxInput);

        minSlider.addEventListener('change', applyFilter);
        maxSlider.addEventListener('change', applyFilter);

        /*
         * Initial state.
         */
        paint(Number(minSlider.value), Number(maxSlider.value));
      });
    }

    document.addEventListener('DOMContentLoaded', initPriceRanges);
    document.addEventListener('shopify:section:load', initPriceRanges);
    document.addEventListener('shopify:section:reorder', initPriceRanges);
    setTimeout(initPriceRanges, 300);
  })();
</script>
