{% comment %} <span class="field-currency">{{ cart.currency.symbol }}</span>

<div class="field">
  <input
    class="field__input"
    name="{{ filter.min_value.param_name }}"
    id="{{ id_prefix }}{{ filter.label | escape }}-GTE"
    {%- if filter.min_value.value -%}
      value="{{ filter.min_value.value | money_without_currency }}"
    {%- endif -%}
    type="text"
    inputmode="decimal"
    placeholder="0"
    data-pattern="\d| |,|\."
    data-min="0"
    data-max="{{ filter.range_max | money_without_currency }}"
  >
  <label class="field__label" for="{{ id_prefix }}{{ filter.label | escape }}-GTE">
    {{- 'products.facets.from' | t -}}
  </label>
</div>

{%- if filter_type != 'vertical' -%}
  <span class="field-currency">{{ cart.currency.symbol }}</span>
{%- endif -%}

<div class="field">
  <input
    class="field__input"
    name="{{ filter.max_value.param_name }}"
    id="{{ id_prefix }}{{ filter.label | escape }}-LTE"
    {%- if filter.max_value.value -%}
      value="{{ filter.max_value.value | money_without_currency }}"
    {%- endif -%}
    type="text"
    inputmode="decimal"
    placeholder="{{ filter.range_max | money_without_currency }}"
    data-pattern="\d| |,|\."
    data-min="0"
    data-max="{{ filter.range_max | money_without_currency }}"
  >
  <label class="field__label" for="{{ id_prefix }}{{ filter.label | escape }}-LTE">
    {{- 'products.facets.to' | t -}}
  </label>
</div> {% endcomment %}
{%- liquid
  assign range_max = filter.range_max | money_without_currency | remove: ',' | strip | plus: 0
  assign min_value = filter.min_value.value | default: 0
  assign max_value = filter.max_value.value | default: range_max
-%}

<div class="custom-price-range" data-price-range>

  <!-- PRICE VALUES -->
  <div class="custom-price-range__values">
    <span class="custom-price-range__value" data-price-min-display>
      {{ min_value | money }}
    </span>

    <span class="custom-price-range__separator">–</span>

    <span class="custom-price-range__value" data-price-max-display>
      {{ max_value | money }}
    </span>
  </div>

  <!-- SLIDER -->
  <div
    class="custom-price-range__slider"
    data-min="0"
    data-max="{{ range_max }}"
  >

    <div class="custom-price-range__track"></div>

    <div
      class="custom-price-range__progress"
      data-price-progress
    ></div>

    <!-- MINIMUM PRICE -->
    <input
      type="range"
      class="custom-price-range__input custom-price-range__input--min"
      min="0"
      max="{{ range_max }}"
      value="{{ min_value }}"
      step="1"
      aria-label="Minimum price"
      data-price-min-slider
    >

    <!-- MAXIMUM PRICE -->
    <input
      type="range"
      class="custom-price-range__input custom-price-range__input--max"
      min="0"
      max="{{ range_max }}"
      value="{{ max_value }}"
      step="1"
      aria-label="Maximum price"
      data-price-max-slider
    >

  </div>

  <!--
    SHOPIFY NATIVE PRICE INPUTS

    These remain in the DOM so Shopify's native
    filtering and AJAX functionality continues
    to work.
  -->
  <div class="custom-price-range__hidden-fields">

    <input
      class="field__input"
      name="{{ filter.min_value.param_name }}"
      id="{{ id_prefix }}{{ filter.label | escape }}-GTE"
      type="text"
      inputmode="decimal"
      value="{{ min_value }}"
      data-price-min-input
      aria-hidden="true"
      tabindex="-1"
    >

    <input
      class="field__input"
      name="{{ filter.max_value.param_name }}"
      id="{{ id_prefix }}{{ filter.label | escape }}-LTE"
      type="text"
      inputmode="decimal"
      value="{{ max_value }}"
      data-price-max-input
      aria-hidden="true"
      tabindex="-1"
    >

  </div>

</div>


<style>

/* =========================================================
   PRICE RANGE CONTAINER
   ========================================================= */

.custom-price-range {
  width: 100%;
  padding: 8px 0 12px;
}


/* =========================================================
   PRICE VALUES
   ========================================================= */

.custom-price-range__values {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 18px;

  font-size: 13px;
  line-height: 1.4;

  color: #000000;
}

.custom-price-range__value {
  font-weight: 400;
  white-space: nowrap;
  color: #000000;
}

.custom-price-range__separator {
  margin: 0 8px;
  color: #000000;
  opacity: 0.45;
}


/* =========================================================
   SLIDER
   ========================================================= */

.custom-price-range__slider {
  position: relative;

  width: 100%;
  height: 24px;
}


/* =========================================================
   BASE TRACK
   ========================================================= */

.custom-price-range__track {
  position: absolute;

  top: 50%;
  left: 0;

  width: 100%;
  height: 2px;

  transform: translateY(-50%);

  background: #d6d6d6;

  border-radius: 2px;

  pointer-events: none;
}


/* =========================================================
   ACTIVE BLACK TRACK
   ========================================================= */

.custom-price-range__progress {
  position: absolute;

  top: 50%;

  height: 2px;

  transform: translateY(-50%);

  background: #000000;

  border-radius: 2px;

  pointer-events: none;
}


/* =========================================================
   RANGE INPUT
   ========================================================= */

.custom-price-range__input {
  position: absolute;

  top: 0;
  left: 0;

  width: 100%;
  height: 24px;

  margin: 0;
  padding: 0;

  background: transparent;

  appearance: none;
  -webkit-appearance: none;

  pointer-events: none;

  outline: none;
}


/* =========================================================
   CHROME / SAFARI TRACK
   ========================================================= */

.custom-price-range__input::-webkit-slider-runnable-track {
  height: 2px;

  background: transparent;

  border: none;
}


/* =========================================================
   FIREFOX TRACK
   ========================================================= */

.custom-price-range__input::-moz-range-track {
  height: 2px;

  background: transparent;

  border: none;
}


/* =========================================================
   BLACK + WHITE HANDLE
   ========================================================= */

.custom-price-range__input::-webkit-slider-thumb {
  width: 18px;
  height: 18px;

  margin-top: -8px;

  border: 1.5px solid #000000;

  border-radius: 50%;

  background: #ffffff;

  cursor: pointer;

  appearance: none;
  -webkit-appearance: none;

  pointer-events: auto;

  box-sizing: border-box;
}


.custom-price-range__input::-moz-range-thumb {
  width: 18px;
  height: 18px;

  border: 1.5px solid #000000;

  border-radius: 50%;

  background: #ffffff;

  cursor: pointer;

  pointer-events: auto;

  box-sizing: border-box;
}


/* =========================================================
   HANDLE HOVER
   ========================================================= */

.custom-price-range__input::-webkit-slider-thumb:hover {
  background: #000000;
}

.custom-price-range__input::-moz-range-thumb:hover {
  background: #000000;
}


/* =========================================================
   HANDLE FOCUS
   ========================================================= */

.custom-price-range__input:focus-visible::-webkit-slider-thumb {
  outline: 2px solid #000000;
  outline-offset: 2px;
}

.custom-price-range__input:focus-visible::-moz-range-thumb {
  outline: 2px solid #000000;
  outline-offset: 2px;
}


/* =========================================================
   LAYERING
   ========================================================= */

.custom-price-range__input--max {
  z-index: 2;
}

.custom-price-range__input--min {
  z-index: 3;
}


/* =========================================================
   HIDE NATIVE SHOPIFY INPUTS
   ========================================================= */

.custom-price-range__hidden-fields {
  position: absolute !important;

  width: 1px !important;
  height: 1px !important;

  padding: 0 !important;
  margin: -1px !important;

  overflow: hidden !important;

  clip: rect(0, 0, 0, 0) !important;

  white-space: nowrap !important;

  border: 0 !important;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  .custom-price-range {
    padding-top: 5px;
  }

  .custom-price-range__values {
    font-size: 14px;
    margin-bottom: 20px;
  }

  .custom-price-range__input::-webkit-slider-thumb {
    width: 20px;
    height: 20px;

    margin-top: -9px;
  }

  .custom-price-range__input::-moz-range-thumb {
    width: 20px;
    height: 20px;
  }

}

</style>


<script>

(() => {

  function initPriceRanges() {

    document
      .querySelectorAll('[data-price-range]')
      .forEach((range) => {

        /*
         * Prevent duplicate initialization
         */
        if (range.dataset.initialized === 'true') {
          return;
        }

        range.dataset.initialized = 'true';


        /* =====================================================
           ELEMENTS
           ===================================================== */

        const minSlider =
          range.querySelector('[data-price-min-slider]');

        const maxSlider =
          range.querySelector('[data-price-max-slider]');

        const minInput =
          range.querySelector('[data-price-min-input]');

        const maxInput =
          range.querySelector('[data-price-max-input]');

        const minDisplay =
          range.querySelector('[data-price-min-display]');

        const maxDisplay =
          range.querySelector('[data-price-max-display]');

        const progress =
          range.querySelector('[data-price-progress]');


        if (
          !minSlider ||
          !maxSlider ||
          !minInput ||
          !maxInput ||
          !minDisplay ||
          !maxDisplay ||
          !progress
        ) {
          return;
        }


        /* =====================================================
           MAX PRICE
           ===================================================== */

        const maxPrice = Number(maxSlider.max);


        /* =====================================================
           FORMAT PRICE
           ===================================================== */

        function formatPrice(value) {

          return new Intl.NumberFormat('en-AE', {

            style: 'currency',

            currency: '{{ cart.currency.iso_code }}',

            minimumFractionDigits: 2,

            maximumFractionDigits: 2

          }).format(Number(value));

        }


        /* =====================================================
           UPDATE SLIDER
           ===================================================== */

        function updateSlider() {

          let min =
            Number(minSlider.value);

          let max =
            Number(maxSlider.value);


          /*
           * Prevent handles from crossing
           */

          if (min >= max) {

            if (
              document.activeElement === minSlider
            ) {

              min = max - 1;

              minSlider.value = min;

            } else {

              max = min + 1;

              maxSlider.value = max;

            }

          }


          /*
           * Calculate percentages
           */

          const minPercent =
            (min / maxPrice) * 100;

          const maxPercent =
            (max / maxPrice) * 100;


          /*
           * Update black active track
           */

          progress.style.left =
            minPercent + '%';

          progress.style.width =
            (maxPercent - minPercent) + '%';


          /*
           * Update displayed prices
           */

          minDisplay.textContent =
            formatPrice(min);

          maxDisplay.textContent =
            formatPrice(max);


          /*
           * Update Shopify's actual inputs
           */

          minInput.value = min;

          maxInput.value = max;

        }


        /* =====================================================
           APPLY SHOPIFY FILTER
           ===================================================== */

        function applyFilter() {

          updateSlider();


          /*
           * Trigger Shopify's native
           * price filtering
           */

          minInput.dispatchEvent(
            new Event('change', {
              bubbles: true
            })
          );


          maxInput.dispatchEvent(
            new Event('change', {
              bubbles: true
            })
          );

        }


        /* =====================================================
           LIVE SLIDER UPDATE
           ===================================================== */

        minSlider.addEventListener(
          'input',
          updateSlider
        );

        maxSlider.addEventListener(
          'input',
          updateSlider
        );


        /* =====================================================
           APPLY FILTER WHEN RELEASED
           ===================================================== */

        minSlider.addEventListener(
          'change',
          applyFilter
        );

        maxSlider.addEventListener(
          'change',
          applyFilter
        );


        /* =====================================================
           INITIAL STATE
           ===================================================== */

        updateSlider();

      });

  }


  /* ===========================================================
     INITIAL PAGE LOAD
     =========================================================== */

  document.addEventListener(
    'DOMContentLoaded',
    initPriceRanges
  );


  /* ===========================================================
     SHOPIFY SECTION LOAD
     =========================================================== */

  document.addEventListener(
    'shopify:section:load',
    initPriceRanges
  );


  document.addEventListener(
    'shopify:section:reorder',
    initPriceRanges
  );


  /* ===========================================================
     HANDLE AJAX / DYNAMIC FILTER RENDERING
     =========================================================== */

  setTimeout(
    initPriceRanges,
    300
  );


})();

</script>