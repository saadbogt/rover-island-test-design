{% doc %}
  @prompt
    Make a Expandable Content section in which the only first 3 lines of the Content is Displayed and All other content is Hidden and there is an un style Button with Underline at the end that say show more and when Click it Display full content 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-expandable-content-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-expandable-content__wrapper-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-expandable-content__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    line-height: {{ block.settings.line_height }};
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-expandable-content__text-{{ ai_gen_id }}.collapsed {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    max-height: calc({{ block.settings.font_size }}px * {{ block.settings.line_height }} * 3);
  }

  .ai-expandable-content__text-{{ ai_gen_id }}.expanded {
    display: block;
    max-height: none;
  }

  .ai-expandable-content__button-{{ ai_gen_id }} {
    background: none;
    border: none;
    padding: 0;
    margin-top: {{ block.settings.button_spacing }}px;
    color: {{ block.settings.button_color }};
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: underline;
    cursor: pointer;
    display: inline-block;
  }

  .ai-expandable-content__button-{{ ai_gen_id }}:hover {
    color: {{ block.settings.button_hover_color }};
  }
{% endstyle %}

<expandable-content-{{ ai_gen_id }}
  class="ai-expandable-content-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-expandable-content__wrapper-{{ ai_gen_id }}">
    <div
      class="ai-expandable-content__text-{{ ai_gen_id }} collapsed"
      data-content
    >
      {{ block.settings.content }}
    </div>
    <button
      class="ai-expandable-content__button-{{ ai_gen_id }}"
      data-toggle
      aria-expanded="false"
    >
      <span data-show-text>{{ block.settings.show_more_text }}</span>
      <span data-hide-text style="display: none;">{{ block.settings.show_less_text }}</span>
    </button>
  </div>
</expandable-content-{{ ai_gen_id }}>

<script>
  (function() {
    class ExpandableContent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.contentElement = this.querySelector('[data-content]');
        this.toggleButton = this.querySelector('[data-toggle]');
        this.showText = this.querySelector('[data-show-text]');
        this.hideText = this.querySelector('[data-hide-text]');

        if (this.toggleButton) {
          this.toggleButton.addEventListener('click', () => this.toggleContent());
        }
      }

      toggleContent() {
        const isExpanded = this.contentElement.classList.contains('expanded');

        if (isExpanded) {
          this.contentElement.classList.remove('expanded');
          this.contentElement.classList.add('collapsed');
          this.toggleButton.setAttribute('aria-expanded', 'false');
          this.showText.style.display = 'inline';
          this.hideText.style.display = 'none';
        } else {
          this.contentElement.classList.remove('collapsed');
          this.contentElement.classList.add('expanded');
          this.toggleButton.setAttribute('aria-expanded', 'true');
          this.showText.style.display = 'none';
          this.hideText.style.display = 'inline';
        }
      }
    }

    customElements.define('expandable-content-{{ ai_gen_id }}', ExpandableContent{{ ai_gen_id }});
  })();
</script>

