{% doc %}
  @prompt
    Create a Quick View feature that lets customers preview product details (images, title, price, variant options, and Add to Cart button) in a modal/popup overlay without leaving the current collection or search results page. The modal should open when clicking a "Quick View" button that appears on product cards on hover, and close when clicking outside or an X button.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-quick-view-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-quick-view-trigger-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: {{ block.settings.button_padding }}px {{ block.settings.button_padding | times: 1.5 }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    width: 100%;
  }

  .ai-quick-view-trigger-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-quick-view-trigger-icon-{{ ai_gen_id }} {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .ai-quick-view-overlay-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity }});
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ai-quick-view-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-quick-view-modal-{{ ai_gen_id }} {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    width: 90%;
    max-width: {{ block.settings.modal_max_width }}px;
    max-height: 90vh;
    background-color: {{ block.settings.modal_bg_color }};
    border-radius: {{ block.settings.modal_border_radius }}px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .ai-quick-view-modal-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
  }

  .ai-quick-view-close-{{ ai_gen_id }} {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    background-color: {{ block.settings.close_button_bg_color }};
    color: {{ block.settings.close_button_color }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: all 0.2s ease;
  }

  .ai-quick-view-close-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.close_button_hover_bg_color }};
    transform: rotate(90deg);
  }

  .ai-quick-view-close-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
  }

  .ai-quick-view-content-{{ ai_gen_id }} {
    overflow-y: auto;
    padding: {{ block.settings.modal_padding }}px;
    flex: 1;
  }

  .ai-quick-view-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-quick-view-images-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-quick-view-main-image-{{ ai_gen_id }} {
    width: 100%;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-quick-view-main-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-quick-view-thumbnails-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    overflow-x: auto;
  }

  .ai-quick-view-thumbnail-{{ ai_gen_id }} {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    border-radius: {{ block.settings.image_border_radius | divided_by: 2 }}px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.2s ease;
  }

  .ai-quick-view-thumbnail-{{ ai_gen_id }}.active {
    border-color: {{ block.settings.button_bg_color }};
  }

  .ai-quick-view-thumbnail-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-quick-view-details-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-quick-view-vendor-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.vendor_color }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
  }

  .ai-quick-view-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }

  .ai-quick-view-price-{{ ai_gen_id }} {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: {{ block.settings.price_font_size }}px;
    font-weight: 600;
  }

  .ai-quick-view-price-current-{{ ai_gen_id }} {
    color: {{ block.settings.price_color }};
  }

  .ai-quick-view-price-compare-{{ ai_gen_id }} {
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
    font-size: {{ block.settings.price_font_size | times: 0.85 }}px;
  }

  .ai-quick-view-description-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    max-height: 120px;
    overflow-y: auto;
  }

  .ai-quick-view-variants-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-quick-view-variant-label-{{ ai_gen_id }} {
    font-size: 13px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin-bottom: 4px;
  }

  .ai-quick-view-variant-options-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ai-quick-view-variant-option-{{ ai_gen_id }} {
    padding: 8px 16px;
    border: 1px solid {{ block.settings.variant_border_color }};
    border-radius: {{ block.settings.variant_border_radius }}px;
    background-color: transparent;
    color: {{ block.settings.text_color }};
    cursor: pointer;
    font-size: 13px;
    transition: all 0.2s ease;
  }

  .ai-quick-view-variant-option-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.button_bg_color }};
  }

  .ai-quick-view-variant-option-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border-color: {{ block.settings.button_bg_color }};
  }

  .ai-quick-view-variant-option-{{ ai_gen_id }}.disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-quick-view-quantity-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-quick-view-quantity-label-{{ ai_gen_id }} {
    font-size: 13px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
  }

  .ai-quick-view-quantity-selector-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    border: 1px solid {{ block.settings.variant_border_color }};
    border-radius: {{ block.settings.variant_border_radius }}px;
    overflow: hidden;
  }

  .ai-quick-view-quantity-btn-{{ ai_gen_id }} {
    width: 36px;
    height: 36px;
    background-color: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.text_color }};
    transition: background-color 0.2s ease;
  }

  .ai-quick-view-quantity-btn-{{ ai_gen_id }}:hover {
    background-color: #f4f4f4;
  }

  .ai-quick-view-quantity-input-{{ ai_gen_id }} {
    width: 50px;
    height: 36px;
    border: none;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
  }

  .ai-quick-view-add-to-cart-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.add_to_cart_padding }}px;
    background-color: {{ block.settings.add_to_cart_bg_color }};
    color: {{ block.settings.add_to_cart_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.add_to_cart_font_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-quick-view-add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.add_to_cart_hover_bg_color }};
  }

  .ai-quick-view-add-to-cart-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-quick-view-view-full-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: {{ block.settings.button_bg_color }};
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .ai-quick-view-view-full-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-quick-view-loading-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px;
    color: {{ block.settings.text_color }};
  }

  .ai-quick-view-spinner-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border: 3px solid #f3f3f3;
    border-top: 3px solid {{ block.settings.button_bg_color }};
    border-radius: 50%;
    animation: ai-quick-view-spin-{{ ai_gen_id }} 1s linear infinite;
  }

  @keyframes ai-quick-view-spin-{{ ai_gen_id }} {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @media screen and (max-width: 749px) {
    .ai-quick-view-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-quick-view-modal-{{ ai_gen_id }} {
      max-height: 95vh;
    }

    .ai-quick-view-content-{{ ai_gen_id }} {
      padding: {{ block.settings.modal_padding | times: 0.75 }}px;
    }

    .ai-quick-view-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<quick-view-{{ ai_gen_id }} class="ai-quick-view-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <button class="ai-quick-view-trigger-{{ ai_gen_id }}" data-product-handle="{{ product.handle }}">
    {% if block.settings.show_icon %}
      <svg class="ai-quick-view-trigger-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
    {% endif %}
    {{ block.settings.button_text }}
  </button>

  <div class="ai-quick-view-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-quick-view-modal-{{ ai_gen_id }}">
    <button class="ai-quick-view-close-{{ ai_gen_id }}" aria-label="Close quick view">
      <svg class="ai-quick-view-close-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="ai-quick-view-content-{{ ai_gen_id }}">
      <div class="ai-quick-view-loading-{{ ai_gen_id }}">
        <div class="ai-quick-view-spinner-{{ ai_gen_id }}"></div>
      </div>
    </div>
  </div>
</quick-view-{{ ai_gen_id }}>

<script>
  (function() {
    class QuickView{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.trigger = this.querySelector('.ai-quick-view-trigger-{{ ai_gen_id }}');
        this.overlay = this.querySelector('.ai-quick-view-overlay-{{ ai_gen_id }}');
        this.modal = this.querySelector('.ai-quick-view-modal-{{ ai_gen_id }}');
        this.closeBtn = this.querySelector('.ai-quick-view-close-{{ ai_gen_id }}');
        this.contentContainer = this.querySelector('.ai-quick-view-content-{{ ai_gen_id }}');
        this.productHandle = this.trigger.dataset.productHandle;
        this.currentVariant = null;
        this.productData = null;
      }

      connectedCallback() {
        this.trigger.addEventListener('click', () => this.open());
        this.closeBtn.addEventListener('click', () => this.close());
        this.overlay.addEventListener('click', () => this.close());

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.modal.classList.contains('active')) {
            this.close();
          }
        });
      }

      async open() {
        this.overlay.classList.add('active');
        this.modal.classList.add('active');
        document.body.style.overflow = 'hidden';

        if (!this.productData) {
          await this.loadProduct();
        }
      }

      close() {
        this.overlay.classList.remove('active');
        this.modal.classList.remove('active');
        document.body.style.overflow = '';
      }

      async loadProduct() {
        try {
          const response = await fetch(`/products/${this.productHandle}.js`);
          this.productData = await response.json();
          this.currentVariant = this.productData.variants[0];
          this.render();
        } catch (error) {
          console.error('Error loading product:', error);
          this.contentContainer.innerHTML = '<div style="padding: 40px; text-align: center;">Error loading product</div>';
        }
      }

      render() {
        const product = this.productData;
        const variant = this.currentVariant;
        const showVendor = {{ block.settings.show_vendor | json }};
        const showDescription = {{ block.settings.show_description | json }};

        let optionsHTML = '';
        if (product.options && product.options.length > 0 && product.options[0] !== 'Title') {
          product.options.forEach((option, optionIndex) => {
            const values = [...new Set(product.variants.map(v => v.options[optionIndex]))];
            
            optionsHTML += `
              <div class="ai-quick-view-variant-group-{{ ai_gen_id }}">
                <div class="ai-quick-view-variant-label-{{ ai_gen_id }}">${option}</div>
                <div class="ai-quick-view-variant-options-{{ ai_gen_id }}">
                  ${values.map(value => {
                    const isSelected = variant.options[optionIndex] === value;
                    const isAvailable = this.isOptionAvailable(optionIndex, value);
                    return `
                      <button 
                        class="ai-quick-view-variant-option-{{ ai_gen_id }} ${isSelected ? 'active' : ''} ${!isAvailable ? 'disabled' : ''}"
                        data-option-index="${optionIndex}"
                        data-value="${value}"
                        ${!isAvailable ? 'disabled' : ''}
                      >
                        ${value}
                      </button>
                    `;
                  }).join('')}
                </div>
              </div>
            `;
          });
        }

        const thumbnailsHTML = product.images.length > 1 ? `
          <div class="ai-quick-view-thumbnails-{{ ai_gen_id }}">
            ${product.images.map((img, index) => `
              <div class="ai-quick-view-thumbnail-{{ ai_gen_id }} ${index === 0 ? 'active' : ''}" data-image-index="${index}">
                <img src="${img}" alt="${product.title}">
              </div>
            `).join('')}
          </div>
        ` : '';

        this.contentContainer.innerHTML = `
          <div class="ai-quick-view-grid-{{ ai_gen_id }}">
            <div class="ai-quick-view-images-{{ ai_gen_id }}">
              <div class="ai-quick-view-main-image-{{ ai_gen_id }}">
                <img src="${product.featured_image}" alt="${product.title}" data-main-image>
              </div>
              ${thumbnailsHTML}
            </div>

            <div class="ai-quick-view-details-{{ ai_gen_id }}">
              ${showVendor && product.vendor ? `<div class="ai-quick-view-vendor-{{ ai_gen_id }}">${product.vendor}</div>` : ''}
              
              <h2 class="ai-quick-view-title-{{ ai_gen_id }}">${product.title}</h2>

              <div class="ai-quick-view-price-{{ ai_gen_id }}">
                <span class="ai-quick-view-price-current-{{ ai_gen_id }}" data-price>
                  ${this.formatMoney(variant.price)}
                </span>
                ${variant.compare_at_price && variant.compare_at_price > variant.price ? `
                  <span class="ai-quick-view-price-compare-{{ ai_gen_id }}" data-compare-price>
                    ${this.formatMoney(variant.compare_at_price)}
                  </span>
                ` : ''}
              </div>

              ${showDescription && product.description ? `
                <div class="ai-quick-view-description-{{ ai_gen_id }}">
                  ${this.truncateHTML(product.description, 200)}
                </div>
              ` : ''}

              ${optionsHTML ? `<div class="ai-quick-view-variants-{{ ai_gen_id }}">${optionsHTML}</div>` : ''}

              <div class="ai-quick-view-quantity-{{ ai_gen_id }}">
                <span class="ai-quick-view-quantity-label-{{ ai_gen_id }}">Quantity</span>
                <div class="ai-quick-view-quantity-selector-{{ ai_gen_id }}">
                  <button class="ai-quick-view-quantity-btn-{{ ai_gen_id }}" data-quantity-decrease>−</button>
                  <input type="number" class="ai-quick-view-quantity-input-{{ ai_gen_id }}" value="1" min="1" data-quantity-input>
                  <button class="ai-quick-view-quantity-btn-{{ ai_gen_id }}" data-quantity-increase>+</button>
                </div>
              </div>

              <button class="ai-quick-view-add-to-cart-{{ ai_gen_id }}" data-add-to-cart ${!variant.available ? 'disabled' : ''}>
                ${variant.available ? '{{ block.settings.add_to_cart_text }}' : 'Sold out'}
              </button>

              <a href="/products/${product.handle}" class="ai-quick-view-view-full-{{ ai_gen_id }}">
                View full details
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        `;

        this.attachEventListeners();
      }

      attachEventListeners() {
        const variantButtons = this.contentContainer.querySelectorAll('.ai-quick-view-variant-option-{{ ai_gen_id }}');
        variantButtons.forEach(btn => {
          btn.addEventListener('click', (e) => {
            const optionIndex = parseInt(e.target.dataset.optionIndex);
            const value = e.target.dataset.value;
            this.selectOption(optionIndex, value);
          });
        });

        const thumbnails = this.contentContainer.querySelectorAll('.ai-quick-view-thumbnail-{{ ai_gen_id }}');
        thumbnails.forEach(thumb => {
          thumb.addEventListener('click', (e) => {
            const index = parseInt(e.currentTarget.dataset.imageIndex);
            this.changeImage(index);
          });
        });

        const decreaseBtn = this.contentContainer.querySelector('[data-quantity-decrease]');
        const increaseBtn = this.contentContainer.querySelector('[data-quantity-increase]');
        const quantityInput = this.contentContainer.querySelector('[data-quantity-input]');

        decreaseBtn.addEventListener('click', () => {
          const currentValue = parseInt(quantityInput.value);
          if (currentValue > 1) {
            quantityInput.value = currentValue - 1;
          }
        });

        increaseBtn.addEventListener('click', () => {
          const currentValue = parseInt(quantityInput.value);
          quantityInput.value = currentValue + 1;
        });

        const addToCartBtn = this.contentContainer.querySelector('[data-add-to-cart]');
        addToCartBtn.addEventListener('click', () => this.addToCart());
      }

      selectOption(optionIndex, value) {
        const newOptions = [...this.currentVariant.options];
        newOptions[optionIndex] = value;

        const newVariant = this.productData.variants.find(v => 
          v.options.every((opt, i) => opt === newOptions[i])
        );

        if (newVariant) {
          this.currentVariant = newVariant;
          this.updateVariantUI();
        }
      }

      updateVariantUI() {
        const priceEl = this.contentContainer.querySelector('[data-price]');
        const comparePriceEl = this.contentContainer.querySelector('[data-compare-price]');
        const addToCartBtn = this.contentContainer.querySelector('[data-add-to-cart]');

        priceEl.textContent = this.formatMoney(this.currentVariant.price);

        if (this.currentVariant.compare_at_price && this.currentVariant.compare_at_price > this.currentVariant.price) {
          if (comparePriceEl) {
            comparePriceEl.textContent = this.formatMoney(this.currentVariant.compare_at_price);
          }
        } else if (comparePriceEl) {
          comparePriceEl.remove();
        }

        addToCartBtn.disabled = !this.currentVariant.available;
        addToCartBtn.textContent = this.currentVariant.available ? '{{ block.settings.add_to_cart_text }}' : 'Sold out';

        const variantButtons = this.contentContainer.querySelectorAll('.ai-quick-view-variant-option-{{ ai_gen_id }}');
        variantButtons.forEach(btn => {
          const optionIndex = parseInt(btn.dataset.optionIndex);
          const value = btn.dataset.value;
          const isSelected = this.currentVariant.options[optionIndex] === value;
          
          btn.classList.toggle('active', isSelected);
        });

        if (this.currentVariant.featured_image) {
          const mainImage = this.contentContainer.querySelector('[data-main-image]');
          mainImage.src = this.currentVariant.featured_image.src;
        }
      }

      changeImage(index) {
        const mainImage = this.contentContainer.querySelector('[data-main-image]');
        const thumbnails = this.contentContainer.querySelectorAll('.ai-quick-view-thumbnail-{{ ai_gen_id }}');
        
        mainImage.src = this.productData.images[index];
        
        thumbnails.forEach((thumb, i) => {
          thumb.classList.toggle('active', i === index);
        });
      }

      isOptionAvailable(optionIndex, value) {
        return this.productData.variants.some(variant => 
          variant.options[optionIndex] === value && variant.available
        );
      }

      async addToCart() {
        const quantityInput = this.contentContainer.querySelector('[data-quantity-input]');
        const quantity = parseInt(quantityInput.value);

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: this.currentVariant.id,
              quantity: quantity
            })
          });

          if (response.ok) {
            window.location.href = '/cart';
          }
        } catch (error) {
          console.error('Error adding to cart:', error);
        }
      }

      formatMoney(cents) {
        const amount = cents / 100;
        return new Intl.NumberFormat('en-US', {
          style: 'currency',
          currency: '{{ cart.currency.iso_code }}',
        }).format(amount);
      }

      truncateHTML(html, maxLength) {
        const div = document.createElement('div');
        div.innerHTML = html;
        const text = div.textContent || div.innerText || '';
        
        if (text.length <= maxLength) {
          return html;
        }
        
        return text.substring(0, maxLength) + '...';
      }
    }

    customElements.define('quick-view-{{ ai_gen_id }}', QuickView{{ ai_gen_id }});
  })();
</script>

