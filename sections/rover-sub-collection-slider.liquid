      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Item text"
    },
    {
      "type": "select",
      "id": "item_font",
      "label": "Font",
      "options": [
        {
          "value": "body",
          "label": "Theme body font"
        },
        {
          "value": "heading",
          "label": "Theme heading font"
        }
      ],
      "default": "body"
    },
    {
      "type": "select",
      "id": "item_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "theme",
          "label": "Theme default"
        },
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
