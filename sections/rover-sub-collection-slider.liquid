      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "item_transform",
      "label": "Letter case",
      "options": [
        {
          "value": "none",
          "label": "As typed"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
