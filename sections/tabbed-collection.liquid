{{ 'section-tabbed-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-typography .tabbed-collection__description {
    font-size: {{ section.settings.desc_size_mobile }}px;
    line-height: {{ section.settings.desc_line_height }};
  }
  .section-{{ section.id }}-typography .tabbed-collection__heading {
    font-size: {{ section.settings.heading_size_mobile }}px;
    line-height: {{ section.settings.heading_line_height }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .section-{{ section.id }}-typography .tabbed-collection__description {
      font-size: {{ section.settings.desc_size_tablet }}px;
    }
    .section-{{ section.id }}-typography .tabbed-collection__heading {
      font-size: {{ section.settings.heading_size_tablet }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-typography .tabbed-collection__description {
      font-size: {{ section.settings.desc_size_desktop }}px;
    }
    .section-{{ section.id }}-typography .tabbed-collection__heading {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }
  }
{%- endstyle -%}

<tabbed-collection
  class="tabbed-collection-section section-{{ section.id }}-padding section-{{ section.id }}-typography page-width"
  style="
    --grid-gap: {{ section.settings.item_gap }}px;
    --tc-items-mobile: {{ section.settings.products_per_view_mobile | default: 2 | plus: 0.05 }};
    --tc-gap-count-mobile: {{ section.settings.products_per_view_mobile | default: 2 }};
    --tc-items-tablet: {{ section.settings.products_per_view_tablet | default: 3 | plus: 0.1 }};
    --tc-gap-count-tablet: {{ section.settings.products_per_view_tablet | default: 3 }};
    --tc-items-desktop: {{ section.settings.products_per_view_desktop | default: 6 | plus: 0.1 }};
    --tc-gap-count-desktop: {{ section.settings.products_per_view_desktop | default: 6 }};
  "
>
  <div class="tabbed-collection__header">
    {%- if section.settings.description != blank -%}
      <p class="tabbed-collection__description">{{ section.settings.description | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="tabbed-collection__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
  </div>

  <div class="tabbed-collection__tabs" role="tablist">
    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      {%- assign tab_title = block.settings.title | default: collection.title | default: 'Collection' -%}
      <button
        type="button"
        id="tab-{{ section.id }}-{{ block.id }}"
        class="tabbed-collection__tab-btn"
        role="tab"
        aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
        aria-controls="panel-{{ section.id }}-{{ block.id }}"
        data-target="panel-{{ section.id }}-{{ block.id }}"
        {{ block.shopify_attributes }}
      >
        {{ tab_title }}
      </button>
    {%- endfor -%}
  </div>

  <div class="tabbed-collection__content">
    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      <div
        id="panel-{{ section.id }}-{{ block.id }}"
        class="tabbed-collection__panel {% if forloop.first %}is-active{% endif %}"
        role="tabpanel"
        aria-labelledby="tab-{{ section.id }}-{{ block.id }}"
        tabindex="0"
      >
        <div class="tabbed-slider-wrapper">
          <button class="tabbed-slider-btn prev" aria-label="Previous slide" disabled>
            <svg viewBox="0 0 14 10" fill="none" class="icon icon-arrow" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M8.537.808a.5.5 0 01.817-.162l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L11.793 5.5H1.5a.5.5 0 010-1h10.293L8.646 1.354a.5.5 0 01-.109-.546z" fill="currentColor" transform="rotate(180 7 5)"></path>
            </svg>
          </button>

          <div class="tabbed-slider-track" data-slide-count="{{ section.settings.products_to_slide | default: 1 }}">
            {%- liquid
              assign products_to_render = collection.products
              if section.settings.show_in_stock_only
                assign products_to_render = collection.products | where: 'available', true
              endif
              assign products_limit = section.settings.products_limit | default: 10
            -%}
            {%- for product in products_to_render limit: products_limit -%}
              <div class="tabbed-slider-slide">
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: 'adapt',
                  show_secondary_image: true,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  lazy_load: true
                %}
              </div>
            {%- else -%}
              {%- for i in (1..6) -%}
                <div class="tabbed-slider-slide">
                  {% render 'card-product', show_vendor: false %}
                </div>
              {%- endfor -%}
            {%- endfor -%}
          </div>

          <button class="tabbed-slider-btn next" aria-label="Next slide">
            <svg viewBox="0 0 14 10" fill="none" class="icon icon-arrow" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M8.537.808a.5.5 0 01.817-.162l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L11.793 5.5H1.5a.5.5 0 010-1h10.293L8.646 1.354a.5.5 0 01-.109-.546z" fill="currentColor"></path>
            </svg>
          </button>
        </div>

        {%- if collection != blank and collection.all_products_count > 0 -%}
          <div class="tabbed-collection__footer">
            <a href="{{ collection.url }}" class="link">Show more</a>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</tabbed-collection>

<script>
  if (!customElements.get('tabbed-collection')) {
    class TabbedCollection extends HTMLElement {
      connectedCallback() {
        // Guard against connectedCallback firing more than once
        // (e.g. if the theme editor moves/reinserts the element, or the
        // custom-element upgrade queue processes several <tabbed-collection>
        // tags in the same batch). This flag MUST be set synchronously,
        // right here - not inside the requestAnimationFrame callback below.
        // Setting it late leaves a window where connectedCallback could
        // fire again before the first rAF resolves, and since the flag was
        // still false both times, both calls would pass the guard and each
        // schedule their own init - doubling every event listener (tabs,
        // arrows, drag) and causing exactly the "arrows do nothing" /
        // "all tabs show at once" symptoms when this section is used more
        // than once on a page.
        if (this._initialized) return;
        this._initialized = true;

        // IMPORTANT: do not read children here synchronously.
        // When this section is used more than once on a page, the browser
        // upgrades every instance after the first one the moment it sees
        // the opening <tabbed-collection> tag - before its tabs/panels
        // have actually been parsed into the DOM. Querying immediately
        // would find nothing for those later instances. Deferring by one
        // tick guarantees the full subtree exists first.
        requestAnimationFrame(() => {
          this.tabs = this.querySelectorAll('.tabbed-collection__tab-btn');
          this.panels = this.querySelectorAll('.tabbed-collection__panel');
          this.normalizeActiveState();
          this.bindEvents();
          this.initSliders();
        });
      }

      // Defensive: guarantee exactly one active tab/panel pair on load,
      // regardless of what the server-rendered HTML actually shipped with.
      // If more than one panel somehow arrives already marked is-active
      // (e.g. from a stale cache, or duplicate section/block ids upstream),
      // this forces it back to a single, correct active pair instead of
      // silently rendering multiple panels stacked on top of each other.
      normalizeActiveState() {
        let activeIndex = Array.from(this.tabs).findIndex(
          (t) => t.getAttribute('aria-selected') === 'true'
        );
        if (activeIndex === -1) activeIndex = 0;

        this.tabs.forEach((t, i) => {
          t.setAttribute('aria-selected', i === activeIndex ? 'true' : 'false');
        });
        this.panels.forEach((p, i) => {
          p.classList.toggle('is-active', i === activeIndex);
        });
      }

      bindEvents() {
        {% comment %} // Match each tab to its panel by POSITION (index), not by ID string.
        // Tabs and panels are always rendered in the same order from the same
        // {% for block in section.blocks %} loop, so tabs[i] and panels[i]
        // always correspond - regardless of whether their id="..." strings
        // are unique anywhere else on the page. This makes tab-switching
        // completely immune to ID collisions between section/block instances
        // (which can happen if a section or block was ever duplicated by
        // copy-pasting raw JSON instead of through the theme editor). {% endcomment %}
        this.tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => {
            this.tabs.forEach((t) => t.setAttribute('aria-selected', 'false'));
            tab.setAttribute('aria-selected', 'true');

            this.panels.forEach((p) => p.classList.remove('is-active'));
            const targetPanel = this.panels[index];
            if (targetPanel) {
              targetPanel.classList.add('is-active');
              this.updateSliderButtons(targetPanel.querySelector('.tabbed-slider-track'));
            }
          });
        });
      }

      initSliders() {
        this.panels.forEach((panel) => {
          const track = panel.querySelector('.tabbed-slider-track');
          const prevBtn = panel.querySelector('.prev');
          const nextBtn = panel.querySelector('.next');

          if (!track) return;

          // --- 1. Arrow Navigation ---
          if (prevBtn && nextBtn) {
            const scrollAmount = () => {
              const slide = track.querySelector('.tabbed-slider-slide');
              const slideCount = parseInt(track.dataset.slideCount, 10) || 1;
              if (!slide) return track.clientWidth * 0.8;
              const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 0;
              return (slide.getBoundingClientRect().width + gap) * slideCount;
            };

            prevBtn.addEventListener('click', () => {
              track.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
            });

            nextBtn.addEventListener('click', () => {
              track.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
            });
          }

          // --- 2. Drag to Scroll (smooth, momentum-based, unifies mouse/touch/pen) ---
          this.attachSmoothDrag(track);

          // --- 3. Arrow State Updates ---
          track.addEventListener('scroll', () => this.updateSliderButtons(track), { passive: true });
          window.addEventListener('resize', () => this.updateSliderButtons(track));

          setTimeout(() => this.updateSliderButtons(track), 100);
        });
      }

      // Pointer Events give one consistent code path for mouse, touch, and pen -
      // avoids the old bug where separate mouse + touch listeners could both
      // fire on hybrid touchscreen laptops and fight each other. Tracks the
      // pointer 1:1 (no artificial multiplier) for a direct-manipulation feel,
      // then applies a friction-based momentum coast on release so the slider
      // settles smoothly into its scroll-snap position instead of stopping dead.
      attachSmoothDrag(track) {
        let isDown = false;
        let moved = false;
        let startX = 0;
        let startScrollLeft = 0;
        let lastX = 0;
        let lastT = 0;
        let velocity = 0;
        let momentumId = null;

        const cancelMomentum = () => {
          if (momentumId) {
            cancelAnimationFrame(momentumId);
            momentumId = null;
          }
        };

        track.addEventListener('pointerdown', (e) => {
          if (e.pointerType === 'mouse' && e.button !== 0) return;
          cancelMomentum();
          isDown = true;
          moved = false;
          startX = e.clientX;
          lastX = e.clientX;
          startScrollLeft = track.scrollLeft;
          lastT = performance.now();
          velocity = 0;
          // NOTE: do NOT call setPointerCapture here. Capturing on every
          // pointerdown - even a stationary click - stops several browsers
          // (Safari especially) from firing the native click event on the
          // <a> underneath, since the click never gets synthesized once an
          // ancestor holds pointer capture. We only capture once we've
          // confirmed an actual drag is happening (see pointermove below),
          // so a real click passes straight through untouched.
        });

        track.addEventListener('pointermove', (e) => {
          if (!isDown) return;
          const dx = e.clientX - startX;
          if (!moved && Math.abs(dx) > 3) {
            moved = true;
            track.classList.add('is-dragging');
            try {
              track.setPointerCapture(e.pointerId);
            } catch (err) {
              /* capture not available/needed */
            }
          }
          if (!moved) return;
          track.scrollLeft = startScrollLeft - dx;

          const now = performance.now();
          const dt = now - lastT;
          if (dt > 0) velocity = (e.clientX - lastX) / dt;
          lastX = e.clientX;
          lastT = now;
        });

        const endDrag = (e) => {
          if (!isDown) return;
          isDown = false;
          track.classList.remove('is-dragging');
          if (moved) {
            try {
              track.releasePointerCapture(e.pointerId);
            } catch (err) {
              /* pointer already released */
            }
          }

          let v = velocity * 16; // approx px/frame at ~60fps
          const friction = 0.94;
          const step = () => {
            if (Math.abs(v) < 0.5) {
              momentumId = null;
              return;
            }
            track.scrollLeft -= v;
            v *= friction;
            momentumId = requestAnimationFrame(step);
          };
          if (Math.abs(v) > 1) momentumId = requestAnimationFrame(step);
        };

        track.addEventListener('pointerup', endDrag);
        track.addEventListener('pointercancel', endDrag);

        // Prevent a dragged card from also firing a click/navigation on release.
        track.addEventListener(
          'click',
          (e) => {
            if (moved) {
              e.preventDefault();
              e.stopPropagation();
            }
          },
          true
        );
      }

      updateSliderButtons(track) {
        if (!track) return;
        const prevBtn = track.parentElement.querySelector('.prev');
        const nextBtn = track.parentElement.querySelector('.next');

        if (prevBtn) prevBtn.disabled = track.scrollLeft <= 0;
        if (nextBtn) {
          const isAtEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
          nextBtn.disabled = isAtEnd;
        }
      }
    }
    customElements.define('tabbed-collection', TabbedCollection);
  }
</script>

{% schema %}
{
  "name": "Tabbed Product Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Short Description",
      "default": "What Everyone's Reaching For"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "VIRAL PICKS 🍒"
    },
    {
      "type": "header",
      "content": "Product Card Settings"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show Vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": true,
      "label": "Show Product Rating"
    },
    {
      "type": "header",
      "content": "Typography: Heading"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Font Size (Mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_size_tablet",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Font Size (Tablet)",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Font Size (Desktop)",
      "default": 40
    },
    {
      "type": "text",
      "id": "heading_line_height",
      "label": "Line Height",
      "default": "1.2"
    },
    {
      "type": "header",
      "content": "Typography: Description"
    },
    {
      "type": "range",
      "id": "desc_size_mobile",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Font Size (Mobile)",
      "default": 14
    },
    {
      "type": "range",
      "id": "desc_size_tablet",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Font Size (Tablet)",
      "default": 16
    },
    {
      "type": "range",
      "id": "desc_size_desktop",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Font Size (Desktop)",
      "default": 16
    },
    {
      "type": "text",
      "id": "desc_line_height",
      "label": "Line Height",
      "default": "1.5"
    },
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "checkbox",
      "id": "show_in_stock_only",
      "label": "Only show in-stock products",
      "info": "Hides sold-out products from every tab's slider.",
      "default": false
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 4,
      "max": 24,
      "step": 1,
      "label": "Total products in slider",
      "info": "How many products to load into each tab's slider.",
      "default": 10
    },
    {
      "type": "range",
      "id": "products_to_slide",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Products to slide per arrow click",
      "default": 1
    },
    {
      "type": "range",
      "id": "products_per_view_mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Products to show (mobile)",
      "default": 2
    },
    {
      "type": "range",
      "id": "products_per_view_tablet",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Products to show (tablet)",
      "default": 3
    },
    {
      "type": "range",
      "id": "products_per_view_desktop",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show (desktop)",
      "default": 6
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Item Gap",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Tab",
      "limit": 6,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Tab Title",
          "info": "Leave blank to use the default collection name."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabbed Product Grid",
      "blocks": [{ "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
