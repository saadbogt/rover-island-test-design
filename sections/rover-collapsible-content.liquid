{%- comment -%}
  Rover Island — Collapsible content (Read more / Read less)

  Shows a heading and rich text clipped to a set number of lines, with a Read more toggle.
  The full text is always in the HTML, so search engines can crawl every word and link.

  Content source (section setting "Content source"):
  - Collection description         → collection.description
  - Collection metafield           → the metafield named in "Metafield" (default custom.full_description)
  - Custom text                    → the "Custom content" box
  If the chosen source is empty, "Custom content" is used as the fallback.
  If everything is empty, the section renders nothing.
{%- endcomment -%}

{%- liquid
  assign content = ''
  assign source = section.settings.content_source

  if source == 'collection_description' and collection != blank
    assign content = collection.description
  elsif source == 'collection_metafield' and collection != blank
    assign mf_parts = section.settings.metafield_key | strip | split: '.'
    if mf_parts.size == 2
      assign mf = collection.metafields[mf_parts[0]][mf_parts[1]]
      if mf != blank
        case mf.type
          when 'rich_text_field'
            assign content = mf | metafield_tag
          when 'multi_line_text_field'
            assign content = mf.value | escape | newline_to_br | prepend: '<p>' | append: '</p>'
          else
            assign content = mf.value
        endcase
      endif
    endif
  endif

  if content == blank
    assign content = section.settings.content
  endif

  assign heading = section.settings.heading
  assign heading_tag = section.settings.heading_tag | default: 'h2'

  if section.settings.heading_font == 'body'
    assign heading_font = 'var(--font-body-family)'
    assign heading_weight_theme = 'var(--font-body-weight)'
  else
    assign heading_font = 'var(--font-heading-family)'
    assign heading_weight_theme = 'var(--font-heading-weight)'
  endif
  assign heading_weight = section.settings.heading_weight
  if heading_weight == 'theme'
    assign heading_weight = heading_weight_theme
  endif

  if section.settings.content_font == 'heading'
    assign content_font = 'var(--font-heading-family)'
  else
    assign content_font = 'var(--font-body-family)'
  endif

  assign content_id = collection.handle | default: page.handle | default: section.id
-%}

{%- if content != blank or heading != blank -%}
  {{ 'rover-collapsible-content.css' | asset_url | stylesheet_tag }}
  {%- if section.settings.enable_tracking -%}
    <script src="{{ 'rover-track.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
  <script src="{{ 'rover-collapsible-content.js' | asset_url }}" defer="defer"></script>

  {%- style -%}
    #shopify-section-{{ section.id }} .rover-cc {
      --rcc-align: {{ section.settings.text_align }};
      --rcc-heading-font: {{ heading_font }};
      --rcc-heading-weight: {{ heading_weight }};
      --rcc-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
      --rcc-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
      --rcc-heading-tracking: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
      --rcc-heading-transform: {{ section.settings.heading_transform }};
      --rcc-heading-gap: {{ section.settings.heading_gap }}px;
      {%- if section.settings.heading_color != blank %}
        --rcc-heading-color: {{ section.settings.heading_color }};
      {%- endif %}
      --rcc-content-font: {{ content_font }};
      --rcc-content-size-mobile: {{ section.settings.content_size_mobile }}px;
      --rcc-content-size-desktop: {{ section.settings.content_size_desktop }}px;
      --rcc-line-height: {{ section.settings.content_line_height | divided_by: 10.0 }};
      --rcc-lines: {{ section.settings.collapsed_lines }};
      {%- if section.settings.content_color != blank %}
        --rcc-content-color: {{ section.settings.content_color }};
      {%- endif %}
      {%- if section.settings.link_color != blank %}
        --rcc-link-color: {{ section.settings.link_color }};
      {%- endif %}
      --rcc-sub-size-mobile: {{ section.settings.subheading_size_mobile }}px;
      --rcc-sub-size-desktop: {{ section.settings.subheading_size_desktop }}px;
      {%- if section.settings.subheading_color != blank %}
        --rcc-sub-color: {{ section.settings.subheading_color }};
      {%- endif %}
      --rcc-button-size: {{ section.settings.button_size }}px;
      --rcc-button-gap: {{ section.settings.button_gap }}px;
      {%- if section.settings.button_align != 'inherit' %}
        --rcc-button-align: {{ section.settings.button_align }};
      {%- endif %}
      {%- if section.settings.button_color != blank %}
        --rcc-button-color: {{ section.settings.button_color }};
      {%- endif %}
      {%- if section.settings.button_hover_color != blank %}
        --rcc-button-hover-color: {{ section.settings.button_hover_color }};
      {%- endif %}
    }

    #shopify-section-{{ section.id }} .rover-cc__section {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      {%- if section.settings.background_color != blank %}
        background-color: {{ section.settings.background_color }};
      {%- endif %}
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .rover-cc__section {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="rover-cc__section color-{{ section.settings.color_scheme }} gradient">
    <rover-collapsible-content
      class="rover-cc page-width{% if section.settings.width == 'narrow' %} page-width--narrow{% endif %}{% if section.settings.show_fade and section.settings.collapsed_lines > 1 %} rover-cc--fade{% endif %}{% if section.settings.button_underline %} rover-cc--underline{% endif %}"
      data-track="{{ section.settings.enable_tracking }}"
      data-content-id="{{ content_id | escape }}"
      data-content-name="{{ heading | strip_html | escape }}"
      data-page-type="{{ request.page_type | escape }}"
    >
      {%- if heading != blank -%}
        <{{ heading_tag }} class="rover-cc__heading">
          {{- heading | escape -}}
        </{{ heading_tag }}>
      {%- endif -%}

      {%- if content != blank -%}
        <div
          class="rover-cc__body"
          id="RoverCcBody-{{ section.id }}"
          data-rcc-body
        >
          {{ content }}
        </div>

        <div class="rover-cc__actions">
          <button
            type="button"
            class="rover-cc__toggle"
            aria-expanded="false"
            aria-controls="RoverCcBody-{{ section.id }}"
            data-rcc-toggle
          >
            <span class="rover-cc__toggle-label">
              <span class="rover-cc__more">{{ section.settings.read_more_label | escape }}</span>
              <span class="rover-cc__less">{{ section.settings.read_less_label | escape }}</span>
            </span>
            {%- if section.settings.show_icon -%}
              <svg class="rover-cc__icon" viewBox="0 0 10 6" aria-hidden="true" focusable="false">
                <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- endif -%}
          </button>
        </div>
      {%- endif -%}
    </rover-collapsible-content>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Rover collapsible content",
  "tag": "section",
  "class": "section rover-cc-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "content_source",
      "label": "Content source",
      "options": [
        {
          "value": "collection_metafield",
          "label": "Collection metafield"
        },
        {
          "value": "collection_description",
          "label": "Collection description"
        },
        {
          "value": "custom",
          "label": "Custom content (below)"
        }
      ],
      "default": "collection_metafield",
      "info": "If the chosen source is empty for a collection, the custom content below is shown instead. If both are empty, the section is hidden."
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield (namespace.key)",
      "default": "custom.full_description",
      "info": "Used when the source is \"Collection metafield\". Rich text, multi-line text and single-line text metafields are supported."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover our skincare edit",
      "info": "Tip: use the dynamic-source icon to connect a collection metafield, so each collection gets its own heading."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Custom content",
      "default": "<p>Use this area for collection guidance, routine tips and frequently asked questions. Only the first few lines show until the shopper selects Read more, and the full text stays readable by search engines.</p>"
    },
    {
      "type": "header",
      "content": "Collapse"
    },
    {
      "type": "range",
      "id": "collapsed_lines",
      "label": "Lines visible when collapsed",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_fade",
      "label": "Fade out the last line",
      "default": true,
      "info": "Applies when 2 or more lines are visible."
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read more label",
      "default": "Read more"
    },
    {
      "type": "text",
      "id": "read_less_label",
      "label": "Read less label",
      "default": "Read less"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1",
      "info": "Colours left empty below use this scheme."
    },
    {
      "type": "select",
      "id": "width",
      "label": "Content width",
      "options": [
        {
          "value": "page",
          "label": "Theme page width"
        },
        {
          "value": "narrow",
          "label": "Narrow (easier reading)"
        }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave empty to use the colour scheme."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Heading style"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag (SEO)",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "p",
          "label": "Paragraph (no heading)"
        }
      ],
      "default": "h2",
      "info": "Keep H2 on collection pages: the collection title is already the H1."
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Font",
      "options": [
        {
          "value": "heading",
          "label": "Theme heading font"
        },
        {
          "value": "body",
          "label": "Theme body font"
        }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "theme",
          "label": "Theme default"
        },
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "theme",
      "info": "Weights the theme font doesn't include are simulated by the browser."
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Font size (mobile)",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Font size (desktop)",
      "min": 14,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "select",
      "id": "heading_transform",
      "label": "Letter case",
      "options": [
        {
          "value": "none",
          "label": "As typed"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 0,
      "info": "0 = normal, 10 = 0.1em"
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Space below heading",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "info": "Leave empty to use the colour scheme."
    },
    {
      "type": "header",
      "content": "Content style"
    },
    {
      "type": "select",
      "id": "content_font",
      "label": "Font",
      "options": [
        {
          "value": "body",
          "label": "Theme body font"
        },
        {
          "value": "heading",
          "label": "Theme heading font"
        }
      ],
      "default": "body"
    },
    {
      "type": "range",
      "id": "content_size_mobile",
      "label": "Font size (mobile)",
      "min": 11,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "content_size_desktop",
      "label": "Font size (desktop)",
      "min": 11,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "content_line_height",
      "label": "Line height",
      "min": 10,
      "max": 25,
      "step": 1,
      "default": 16,
      "info": "16 = 1.6"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Text color",
      "info": "Leave empty to use the colour scheme."
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "info": "Leave empty to use the colour scheme."
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "label": "Sub-heading size inside content (mobile)",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 16,
      "info": "Styles the H2/H3 headings that sit inside the content. H3 and smaller are shown slightly smaller."
    },
    {
      "type": "range",
      "id": "subheading_size_desktop",
      "label": "Sub-heading size inside content (desktop)",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Sub-heading color",
      "info": "Leave empty to match the heading colour."
    },
    {
      "type": "header",
      "content": "Read more button"
    },
    {
      "type": "range",
      "id": "button_size",
      "label": "Font size",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "button_underline",
      "label": "Underline label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show arrow icon",
      "default": false
    },
    {
      "type": "select",
      "id": "button_align",
      "label": "Alignment",
      "options": [
        {
          "value": "inherit",
          "label": "Same as text"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "button_gap",
      "label": "Space above button",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "info": "Leave empty to use the colour scheme."
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover color",
      "info": "Leave empty to keep the same colour on hover."
    },
    {
      "type": "header",
      "content": "Tracking"
    },
    {
      "type": "checkbox",
      "id": "enable_tracking",
      "label": "Send Read more event",
      "default": true,
      "info": "Sends rover_content_expand once per page view to GTM's dataLayer and Shopify Customer Events."
    }
  ],
  "presets": [
    {
      "name": "Rover collapsible content"
    }
  ]
}
{% endschema %}
