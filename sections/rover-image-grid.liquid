{{ 'rover-image-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_layout   = section.settings.layout_type
  assign use_custom_width = section.settings.use_custom_width
  assign custom_width     = section.settings.custom_width
  assign col_desktop      = section.settings.columns_desktop
  assign col_mobile       = section.settings.columns_mobile
  assign gap_col          = section.settings.gap_columns
  assign gap_row          = section.settings.gap_rows
  assign pt               = section.settings.padding_top
  assign pb               = section.settings.padding_bottom
-%}

{%- style -%}
  #rover-img-{{ section.id }} {
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
  }

  #rover-img-{{ section.id }} .rover-img__inner {
    {%- if use_custom_width and custom_width > 0 -%}
      max-width: {{ custom_width }}px;
    {%- else -%}
      max-width: var(--page-width, 1440px);
    {%- endif -%}
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  {%- if section_layout == 'grid' -%}
    #rover-img-{{ section.id }} .rover-img__grid {
      display: grid;
      grid-template-columns: repeat({{ col_desktop }}, 1fr);
      column-gap: {{ gap_col }}px;
      row-gap: {{ gap_row }}px;
    }
    @media (max-width: 749px) {
      #rover-img-{{ section.id }} .rover-img__grid {
        grid-template-columns: repeat({{ col_mobile }}, 1fr);
      }
    }
  {%- else -%}
    #rover-img-{{ section.id }} .rover-img__grid {
      display: block;
    }
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- liquid
      assign bid = block.id
    -%}

    {%- comment -%} ── Overlay heading styles ── {%- endcomment -%}
    #rover-img-block-{{ bid }} .rover-img-block__overlay-heading {
      font-size: {{ block.settings.overlay_heading_size_desktop }}px;
      color: {{ block.settings.overlay_heading_color }};
      margin: 0;
      line-height: 1.25;
      font-weight: 500;
      letter-spacing: -0.01em;
    }

    {%- comment -%} ── Overlay subtext styles ── {%- endcomment -%}
    #rover-img-block-{{ bid }} .rover-img-block__overlay-sub {
      font-size: {{ block.settings.overlay_sub_size_desktop }}px;
      color: {{ block.settings.overlay_sub_color }};
      margin: 0;
      line-height: 1.6;
    }

    {%- comment -%} ── Overlay text group spacing ── {%- endcomment -%}
    #rover-img-block-{{ bid }} .rover-img-block__overlay-text {
      display: flex;
      flex-direction: column;
      gap: {{ block.settings.gap_heading_sub }}px;
    }

    {%- comment -%} ── Overlay background ── {%- endcomment -%}
    #rover-img-block-{{ bid }} .rover-img-block__overlay-bg {
      background-color: {{ block.settings.overlay_bg }};
      padding: {{ block.settings.overlay_padding }}px;
    }

    {%- comment -%} ── Overlay position ── {%- endcomment -%}
    {%- assign text_pos = block.settings.text_position -%}
    {%- case text_pos -%}
      {%- when 'top_left' -%}
        #rover-img-block-{{ bid }} .rover-img-block__overlay {
          justify-content: flex-start;
          align-items: flex-start;
        }
      {%- when 'top_center' -%}
        #rover-img-block-{{ bid }} .rover-img-block__overlay {
          justify-content: flex-start;
          align-items: center;
          text-align: center;
        }
      {%- when 'top_right' -%}
        #rover-img-block-{{ bid }} .rover-img-block__overlay {
          justify-content: flex-start;
          align-items: flex-end;
          text-align: right;
        }
      {%- when 'middle_left' -%}
        #rover-img-block-{{ bid }} .rover-img-block__overlay {
          justify-content: center;
          align-items: flex-start;
        }
      {%- when 'middle_center' -%}
        #rover-img-block-{{ bid }} .rover-img-block__overlay {
          justify-content: center;
          align-items: center;
          text-align: center;
        }
      {%- when 'middle_right' -%}
        #rover-img-block-{{ bid }} .rover-img-block__overlay {
          justify-content: center;
          align-items: flex-end;
          text-align: right;
        }
      {%- when 'bottom_left' -%}
        #rover-img-block-{{ bid }} .rover-img-block__overlay {
          justify-content: flex-end;
          align-items: flex-start;
        }
      {%- when 'bottom_center' -%}
        #rover-img-block-{{ bid }} .rover-img-block__overlay {
          justify-content: flex-end;
          align-items: center;
          text-align: center;
        }
      {%- when 'bottom_right' -%}
        #rover-img-block-{{ bid }} .rover-img-block__overlay {
          justify-content: flex-end;
          align-items: flex-end;
          text-align: right;
        }
    {%- endcase -%}

    {%- comment -%} ── Mobile font sizes ── {%- endcomment -%}
    @media (max-width: 749px) {
      #rover-img-block-{{ bid }} .rover-img-block__overlay-heading {
        font-size: {{ block.settings.overlay_heading_size_mobile }}px;
      }
      #rover-img-block-{{ bid }} .rover-img-block__overlay-sub {
        font-size: {{ block.settings.overlay_sub_size_mobile }}px;
      }
    }
  {%- endfor -%}
{%- endstyle -%}

<section
  id="rover-img-{{ section.id }}"
  class="rover-img-section"
  aria-label="Image section"
>
  <div class="rover-img__inner">
    <div class="rover-img__grid">

      {%- for block in section.blocks -%}
        {%- liquid
          assign bid          = block.id
          assign block_image  = block.settings.image
          assign block_alt    = block.settings.image_alt | escape
          assign block_link   = block.settings.link
          assign link_new_tab = block.settings.link_new_tab

          assign show_heading = block.settings.show_overlay_heading
          assign show_sub     = block.settings.show_overlay_sub
          assign over_head    = block.settings.overlay_heading
          assign over_sub     = block.settings.overlay_subtext
          assign heading_tag  = block.settings.overlay_heading_tag

          assign has_overlay = false
          if show_heading and over_head != blank
            assign has_overlay = true
          elsif show_sub and over_sub != blank
            assign has_overlay = true
          endif

          assign sizes_mobile  = '(max-width: 749px) calc(100vw / ' | append: col_mobile | append: ')'
          assign sizes_desktop = 'calc(100vw / ' | append: col_desktop | append: ')'
          assign grid_sizes    = sizes_mobile | append: ', ' | append: sizes_desktop
        -%}

        <div
          id="rover-img-block-{{ bid }}"
          class="rover-img-block"
          {{ block.shopify_attributes }}
        >

          {%- comment -%} ── Link open ── {%- endcomment -%}
          {%- if block_link != blank -%}
            <a
              href="{{ block_link }}"
              class="rover-img-block__link"
              {%- if link_new_tab %} target="_blank" rel="noopener noreferrer"{%- endif %}
              {%- if over_head != blank %} aria-label="{{ over_head | escape }}"{%- endif %}
            >
          {%- endif -%}

          {%- comment -%} ── Media wrap ── {%- endcomment -%}
          <div class="rover-img-block__media-wrap">

            {%- comment -%} ── Image ── {%- endcomment -%}
            {%- if block_image != blank -%}
              {%- if section_layout == 'grid' -%}
                {{
                  block_image
                  | image_url: width: 2000
                  | image_tag:
                    loading: 'lazy',
                    class: 'rover-img-block__img',
                    alt: block_alt,
                    widths: '375, 550, 750, 900, 1100, 1500, 2000',
                    sizes: grid_sizes
                }}
              {%- else -%}
                {{
                  block_image
                  | image_url: width: 3200
                  | image_tag:
                    loading: 'lazy',
                    class: 'rover-img-block__img',
                    alt: block_alt,
                    widths: '375, 550, 750, 900, 1100, 1500, 2000, 2600, 3200',
                    sizes: '100vw'
                }}
              {%- endif -%}
            {%- else -%}
              <div class="rover-img-block__placeholder">
                {{ 'image' | placeholder_svg_tag: 'rover-img-block__placeholder-svg' }}
              </div>
            {%- endif -%}

            {%- comment -%} ── Overlay ── {%- endcomment -%}
            {%- if has_overlay -%}
              <div class="rover-img-block__overlay" aria-hidden="true">
                <div class="rover-img-block__overlay-bg">
                  <div class="rover-img-block__overlay-text">
                    {%- if show_heading and over_head != blank -%}
                      <{{ heading_tag }} class="rover-img-block__overlay-heading">
                        {{- over_head | escape -}}
                      </{{ heading_tag }}>
                    {%- endif -%}
                    {%- if show_sub and over_sub != blank -%}
                      <p class="rover-img-block__overlay-sub">
                        {{- over_sub | escape -}}
                      </p>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endif -%}

          </div>
          {%- comment -%} ── Link close ── {%- endcomment -%}
          {%- if block_link != blank -%}
            </a>
          {%- endif -%}

        </div>
      {%- endfor -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image Grid",
  "tag": "section",
  "class": "rover-image-grid-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "radio",
      "id": "layout_type",
      "label": "Layout type",
      "options": [
        { "value": "grid",   "label": "Grid"         },
        { "value": "single", "label": "Single image" }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "use_custom_width",
      "label": "Use custom section width",
      "default": false
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom section width (px)",
      "min": 600,
      "max": 1800,
      "step": 12,
      "default": 1440,
      "info": "Only applies when 'Use custom section width' is enabled."
    },
    {
      "type": "header",
      "content": "Grid columns"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns — desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns — mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "Grid spacing"
    },
    {
      "type": "range",
      "id": "gap_columns",
      "label": "Gap between columns (px)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_rows",
      "label": "Gap between rows (px)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 16
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Alt text",
          "info": "Describe the image for screen readers and SEO."
        },
        {
          "type": "header",
          "content": "Link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL",
          "info": "Leave blank for no link."
        },
        {
          "type": "checkbox",
          "id": "link_new_tab",
          "label": "Open in new tab",
          "default": false
        },
        {
          "type": "header",
          "content": "Overlay position"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position on image",
          "options": [
            { "value": "top_left",      "label": "Top left"      },
            { "value": "top_center",    "label": "Top center"    },
            { "value": "top_right",     "label": "Top right"     },
            { "value": "middle_left",   "label": "Middle left"   },
            { "value": "middle_center", "label": "Middle center" },
            { "value": "middle_right",  "label": "Middle right"  },
            { "value": "bottom_left",   "label": "Bottom left"   },
            { "value": "bottom_center", "label": "Bottom center" },
            { "value": "bottom_right",  "label": "Bottom right"  }
          ],
          "default": "bottom_left"
        },
        {
          "type": "color",
          "id": "overlay_bg",
          "label": "Overlay background color",
          "default": "#000000",
          "info": "Use the alpha slider to control opacity."
        },
        {
          "type": "range",
          "id": "overlay_padding",
          "label": "Overlay padding (px)",
          "min": 0,
          "max": 48,
          "step": 2,
          "default": 12
        },
        {
          "type": "header",
          "content": "Overlay heading"
        },
        {
          "type": "checkbox",
          "id": "show_overlay_heading",
          "label": "Show heading",
          "default": false
        },
        {
          "type": "text",
          "id": "overlay_heading",
          "label": "Heading text"
        },
        {
          "type": "select",
          "id": "overlay_heading_tag",
          "label": "Heading HTML tag",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" },
            { "value": "p",  "label": "Paragraph" }
          ],
          "default": "h3"
        },
        {
          "type": "color",
          "id": "overlay_heading_color",
          "label": "Heading color",
          "default": "#ffffff"
        },
        {
          "type": "range",
          "id": "overlay_heading_size_desktop",
          "label": "Heading size — desktop (px)",
          "min": 10,
          "max": 80,
          "step": 1,
          "default": 22
        },
        {
          "type": "range",
          "id": "overlay_heading_size_mobile",
          "label": "Heading size — mobile (px)",
          "min": 10,
          "max": 60,
          "step": 1,
          "default": 18
        },
        {
          "type": "header",
          "content": "Overlay subtext"
        },
        {
          "type": "checkbox",
          "id": "show_overlay_sub",
          "label": "Show subtext",
          "default": false
        },
        {
          "type": "text",
          "id": "overlay_subtext",
          "label": "Subtext"
        },
        {
          "type": "color",
          "id": "overlay_sub_color",
          "label": "Subtext color",
          "default": "#f0f0f0"
        },
        {
          "type": "range",
          "id": "overlay_sub_size_desktop",
          "label": "Subtext size — desktop (px)",
          "min": 10,
          "max": 40,
          "step": 1,
          "default": 15
        },
        {
          "type": "range",
          "id": "overlay_sub_size_mobile",
          "label": "Subtext size — mobile (px)",
          "min": 10,
          "max": 30,
          "step": 1,
          "default": 14
        },
        {
          "type": "header",
          "content": "Overlay text spacing"
        },
        {
          "type": "range",
          "id": "gap_heading_sub",
          "label": "Gap between heading and subtext (px)",
          "min": 0,
          "max": 48,
          "step": 2,
          "default": 8
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Grid",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
